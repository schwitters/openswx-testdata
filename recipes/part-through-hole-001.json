{
  "schema_version": 1,
  "id": "part-through-hole-001",
  "description": "A 20 x 30 x 40 mm block with a centered radius-5 mm cylindrical through bore.",
  "length_unit": "metre",
  "angle_unit": "radian",
  "steps": [
    {
      "id": "create-document",
      "operation": "create_part",
      "parameters": {
        "configuration": "Default"
      }
    },
    {
      "id": "sketch-outer",
      "operation": "sketch_rectangle",
      "parameters": {
        "plane": "XY",
        "origin_m": [
          0,
          0,
          0
        ],
        "width_m": 0.02,
        "depth_m": 0.03,
        "sketch_id": "base-profile"
      }
    },
    {
      "id": "extrude-base",
      "operation": "extrude",
      "parameters": {
        "profiles": [
          "sketch-outer"
        ],
        "height_m": 0.04,
        "direction": [
          0,
          0,
          1
        ],
        "operation": "new_body"
      }
    },
    {
      "id": "sketch-hole",
      "operation": "sketch_circle",
      "parameters": {
        "plane": "XY",
        "center_m": [
          0.01,
          0.015,
          0.04
        ],
        "radius_m": 0.005,
        "sketch_id": "hole-profile"
      }
    },
    {
      "id": "cut-hole",
      "operation": "extrude",
      "parameters": {
        "profiles": [
          "sketch-hole"
        ],
        "direction": [
          0,
          0,
          -1
        ],
        "operation": "cut",
        "end_condition": "through_all"
      }
    }
  ],
  "analytic": {
    "shape": "through_hole",
    "dimensions_m": {
      "width": 0.02,
      "depth": 0.03,
      "height": 0.04,
      "bore_radius": 0.005,
      "bore_x": 0.01,
      "bore_y": 0.015
    }
  }
}
