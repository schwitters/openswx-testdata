{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "length_unit": {
      "const": "metre"
    },
    "angle_unit": {
      "const": "radian"
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "create_part"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "configuration": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "configuration"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "sketch_rectangle"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "plane": {
                    "const": "XY"
                  },
                  "origin_m": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "width_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "depth_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sketch_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                  }
                },
                "required": [
                  "plane",
                  "origin_m",
                  "width_m",
                  "depth_m",
                  "sketch_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "sketch_polygon"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "plane": {
                    "enum": [
                      "XY",
                      "XZ"
                    ]
                  },
                  "origin_m": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "sketch_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                  },
                  "vertices_m": {
                    "type": "array",
                    "minItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                "required": [
                  "plane",
                  "origin_m",
                  "vertices_m",
                  "sketch_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "sketch_circle"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "plane": {
                    "const": "XY"
                  },
                  "center_m": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sketch_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                  }
                },
                "required": [
                  "plane",
                  "center_m",
                  "radius_m",
                  "sketch_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "extrude"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "profiles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "height_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "direction": {
                    "enum": [
                      [
                        0,
                        0,
                        1
                      ],
                      [
                        0,
                        0,
                        -1
                      ]
                    ]
                  },
                  "operation": {
                    "enum": [
                      "new_body",
                      "cut"
                    ]
                  },
                  "end_condition": {
                    "enum": [
                      "blind",
                      "through_all"
                    ]
                  }
                },
                "required": [
                  "profiles",
                  "direction",
                  "operation"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "end_condition"
                      ],
                      "properties": {
                        "end_condition": {
                          "const": "through_all"
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "required": [
                          "height_m"
                        ]
                      },
                      "properties": {
                        "operation": {
                          "const": "cut"
                        }
                      }
                    },
                    "else": {
                      "required": [
                        "height_m"
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "sketch_semicircle"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "plane": {
                    "const": "XZ"
                  },
                  "center_m": {
                    "const": [
                      0,
                      0,
                      0
                    ]
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sketch_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                  },
                  "half_plane": {
                    "const": "positive_x"
                  }
                },
                "required": [
                  "plane",
                  "center_m",
                  "radius_m",
                  "sketch_id",
                  "half_plane"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "sketch_spherical_cap"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "plane": {
                    "const": "XZ"
                  },
                  "center_m": {
                    "const": [
                      0,
                      0,
                      0
                    ]
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sketch_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                  },
                  "half_plane": {
                    "const": "positive_x"
                  },
                  "cap_height_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "plane",
                  "center_m",
                  "radius_m",
                  "sketch_id",
                  "half_plane",
                  "cap_height_m"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
              },
              "operation": {
                "const": "revolve"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "profiles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "maxItems": 1
                  },
                  "operation": {
                    "const": "new_body"
                  },
                  "axis_origin_m": {
                    "const": [
                      0,
                      0,
                      0
                    ]
                  },
                  "axis_direction": {
                    "const": [
                      0,
                      0,
                      1
                    ]
                  },
                  "angle_rad": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 6.283185307179586
                  }
                },
                "required": [
                  "profiles",
                  "axis_origin_m",
                  "axis_direction",
                  "angle_rad",
                  "operation"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "analytic": {
      "type": "object",
      "properties": {
        "shape": {
          "enum": [
            "block",
            "cylinder",
            "tube",
            "blind_hole",
            "through_hole",
            "stepped_bore",
            "two_holes",
            "concave_profile",
            "multiple_solids",
            "cone_frustum",
            "cone_sector",
            "sphere",
            "sphere_cap"
          ]
        },
        "dimensions_m": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "angle_rad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 6.283185307179586
        }
      },
      "required": [
        "shape",
        "dimensions_m"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "cone_sector"
              }
            }
          },
          "then": {
            "required": [
              "angle_rad"
            ]
          },
          "else": {
            "not": {
              "required": [
                "angle_rad"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "description",
    "length_unit",
    "angle_unit",
    "steps",
    "analytic"
  ],
  "additionalProperties": false
}
